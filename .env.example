# fleet-agent-mcp (Fritz) — environment configuration
# Copy to .env and fill in your values.
# All vars are prefixed with FLEET_AGENT_ (see config.py).

# Server
# FLEET_AGENT_HOST=127.0.0.1
# FLEET_AGENT_PORT=10996
# FLEET_AGENT_TRANSPORT=http

# Agent identity
# FLEET_AGENT_AGENT_NAME=Fritz
# FLEET_AGENT_HUMAN_NAME=Sandra

# Heartbeat (cron-based autonomous wake-up)
# FLEET_AGENT_HEARTBEAT_ENABLED=false
# FLEET_AGENT_HEARTBEAT_INTERVAL_MINUTES=30

# Voice Command Bus (dev commands — see mcp-central-docs/standards/VOICE_COMMAND_BUS.md §4b)
# FLEET_STARTS_UI_URL=http://127.0.0.1:10791
# FLEET_STARTS_DIR=D:\Dev\repos\mcp-central-docs\starts
# FLEET_DEV_INVOKEAI_URL=http://127.0.0.1:11154
# FLEET_VLC_PATH=C:\Program Files\VideoLAN\VLC\vlc.exe
# PLEX_BASE_URL=http://localhost:32400
# PLEX_TOKEN=your_plex_token
