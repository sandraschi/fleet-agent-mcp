{
  "$schema": "https://biomejs.dev/schemas/2.x/schema.json",
  "files": {
    "ignore": ["node_modules", "dist", "build", "*.min.js"]
  },
  "linter": {
    "enabled": true,
    "rules": {
      "recommended": true,
      "style": {
        "noNonNullAssertion": "off"
      }
    }
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "tab"
  },
  "organizeImports": {
    "enabled": true
  }
}
